{
  "name": "school-erp-backend",
  "version": "1.0.0",
  "description": "School ERP System - Backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:roles": "node src/database/seed/role-permission.seed.js",
    "seed:admin": "node src/database/seed/super-admin.seed.js",
    "seed:rooms": "node src/database/seed/room.seed.js",
    "seed:academic": "node src/database/seed/academic-structure.seed.js",
    "seed:periods": "node src/database/seed/period.seed.js",
    "seed": "yarn seed:roles && yarn seed:admin && yarn seed:rooms && yarn seed:academic && yarn seed:periods",
    "seed:demo": "node src/database/seed/demo-data.seed.js",
    "test": "node --test tests/*.test.mjs",
    "verify:routes": "node scripts/verify-routes.mjs"
  },
  "keywords": [
    "school",
    "erp",
    "education"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
